    <ProjectReference Include="..\..\src\Modules\Catalog\StrmManager.Modules.Catalog.Application\StrmManager.Modules.Catalog.Application.csproj" />
    <ProjectReference Include="..\..\src\Modules\Catalog\StrmManager.Modules.Catalog.Infrastructure\StrmManager.Modules.Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Modules\Catalog\StrmManager.Modules.Catalog.Presentation\StrmManager.Modules.Catalog.Presentation.csproj" />
    <ProjectReference Include="..\..\src\Common\StrmManager.Common.Domain\StrmManager.Common.Domain.csproj" />
    <ProjectReference Include="..\..\src\Common\StrmManager.Common.Application\StrmManager.Common.Application.csproj" />
  </ItemGroup>

