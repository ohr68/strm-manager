    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\MediaProcessing\StrmManager.Modules.MediaProcessing.Application\StrmManager.Modules.MediaProcessing.Application.csproj" />
